VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_APP_CHECK_RECAPTCHA_ENTERPRISE_KEY=
# Development only. Never configure this in production.
VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=
VITE_ENABLE_LOCAL_COURSE_FALLBACK=false
VITE_FIREBASE_USE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
VITE_FIREBASE_STORAGE_EMULATOR=true
VITE_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_STORAGE_EMULATOR_PORT=9199
VITE_COURSE_CONTENT_SOURCE=firebase
VITE_PRACTICE_CONTENT_SOURCE=firebase
VITE_ENABLE_LOCAL_PRACTICE_FALLBACK=false
VITE_ENABLE_LOCAL_CHALLENGE_FALLBACK=true
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# Server-only selector for an immutable approved infrastructure tuple. Leave
# unset for local ADC development; deployed environments must use an approved
# production or validation boundary. Never expose this through VITE_*.
AI_TUTOR_RUNTIME_BOUNDARY=
# Local tooling only. Production AI Tutor explicitly rejects service-account JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Server-only, non-secret WIF resource configuration. The platform OIDC token is
# supplied by Vercel request context and must never be added to this file.
GOOGLE_WIF_AUDIENCE=
GOOGLE_WIF_SERVICE_ACCOUNT_EMAIL=
# Server-only AI Tutor configuration. Never prefix the API key with VITE_.
AI_PROVIDER=huggingface
AI_MODEL=openai/gpt-oss-120b:fastest
AI_TUTOR_APPROVED_PROVIDER=
AI_TUTOR_APPROVED_MODEL=
HF_TOKEN=
OPENAI_API_KEY=
# Emergency-safe server gate. For local testing, explicitly set enabled=true,
# rollout=100, a non-secret local salt, and process-local quota=true.
AI_TUTOR_ENABLED=false
AI_TUTOR_ROLLOUT_PERCENTAGE=0
AI_TUTOR_ROLLOUT_VERSION=disabled
AI_TUTOR_ROLLOUT_SALT=
AI_TUTOR_ALLOWLIST_UIDS=
AI_TUTOR_SMOKE_TEST_SECRET=
AI_TUTOR_SMOKE_TEST_UID=
AI_TUTOR_EVALUATION_ENABLED=false
# Production supports the Firestore transaction adapter. Leave blank locally.
AI_TUTOR_QUOTA_BACKEND=
AI_TUTOR_QUOTA_DATABASE_ID=ai-tutor-quota
AI_TUTOR_QUOTA_IDENTITY_SALT=
AI_TUTOR_QUOTA_BURST_REQUESTS=
AI_TUTOR_QUOTA_BURST_WINDOW_SECONDS=
AI_TUTOR_QUOTA_SUSTAINED_REQUESTS=
AI_TUTOR_QUOTA_SUSTAINED_WINDOW_SECONDS=
AI_TUTOR_QUOTA_HOURLY_REQUESTS=
AI_TUTOR_QUOTA_DAILY_REQUESTS=
AI_TUTOR_QUOTA_DAILY_INPUT_TOKENS=
AI_TUTOR_QUOTA_DAILY_OUTPUT_TOKENS=
AI_TUTOR_QUOTA_DAILY_COST_MICROS=
# Reviewed constraints for the exact approved provider/model. Required in production.
AI_TUTOR_PROVIDER_MAX_INPUT_TOKENS=
AI_TUTOR_PROVIDER_INPUT_OVERHEAD_TOKENS=
# Optional server-owned pricing. Cost remains unknown until both values exist.
# Both values are mandatory when AI_TUTOR_QUOTA_DAILY_COST_MICROS is configured.
AI_TUTOR_INPUT_USD_PER_MILLION_TOKENS=
AI_TUTOR_OUTPUT_USD_PER_MILLION_TOKENS=
# Process-local quotas are development-only and never a production fallback.
AI_ALLOW_PROCESS_LOCAL_QUOTA=false
# Local development may use Application Default Credentials or test doubles.
# Every deployed approved boundary uses Vercel OIDC -> Google WIF only.
