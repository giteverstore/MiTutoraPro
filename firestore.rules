rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function attemptOwner(attemptId) {
      return signedIn() && get(/databases/$(database)/documents/examAttempts/$(attemptId)).data.ownerUid == request.auth.uid;
    }
    function runningAttemptOwner(attemptId) {
      let attempt = get(/databases/$(database)/documents/examAttempts/$(attemptId)).data;
      return signedIn() && attempt.ownerUid == request.auth.uid && attempt.state == 'RUNNING';
    }
    function validUserCreate(uid) {
      return request.resource.data.keys().hasOnly([
          'uid', 'email', 'name', 'avatar', 'emailVerified', 'providers',
          'createdAt', 'lastLogin', 'learningPreferences'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.avatar is string
        && request.resource.data.emailVerified is bool
        && request.resource.data.providers is list
        && request.resource.data.createdAt is string
        && request.resource.data.lastLogin is string
        && (!('email' in request.auth.token) || request.resource.data.email == request.auth.token.email)
        && (!('email_verified' in request.auth.token) || request.resource.data.emailVerified == request.auth.token.email_verified);
    }
    function validUserUpdate() {
      return request.resource.data.keys().hasOnly([
          'uid', 'email', 'name', 'avatar', 'emailVerified', 'providers',
          'createdAt', 'lastLogin', 'learningPreferences'
        ])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'avatar', 'learningPreferences', 'lastLogin'])
        && request.resource.data.name is string
        && request.resource.data.avatar is string
        && request.resource.data.lastLogin is string;
    }
    function validProgressRevision(courseId) {
      return request.resource.data.courseId == courseId
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1;
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid) && validUserCreate(uid);
      allow update: if owns(uid) && validUserUpdate();
      allow delete: if false;

      match /progress/{courseId} {
        allow read: if owns(uid);
        allow create: if owns(uid) && validProgressRevision(courseId) && request.resource.data.revision == 1;
        allow update: if owns(uid) && validProgressRevision(courseId)
          && (
            (!('revision' in resource.data) && request.resource.data.revision == 1)
            || (resource.data.revision is int && request.resource.data.revision == resource.data.revision + 1)
          );
        allow delete: if owns(uid);
      }
      match /bookmarks/{bookmarkId} { allow read, write: if owns(uid); }
      match /settings/{settingId} { allow read, write: if owns(uid); }
      match /referrals/{referralId} { allow read: if owns(uid); allow write: if false; }
      match /referralIdentity/{identityId} { allow read: if owns(uid); allow write: if false; }
      match /referralAttribution/{attributionId} { allow read: if owns(uid); allow write: if false; }
      match /referralReadModel/{referralId} { allow read: if owns(uid); allow write: if false; }
      match /achievements/{achievementId} { allow read: if owns(uid); allow write: if false; }
      match /statistics/{statisticsId} { allow read: if owns(uid); allow write: if false; }
      match /coinTransactions/{transactionId} { allow read: if owns(uid); allow write: if false; }
      match /coinAccount/{accountId} { allow read: if owns(uid); allow write: if false; }
      match /wallet/{accountId} { allow read: if owns(uid); allow write: if false; }
      match /walletTransactions/{transactionId} { allow read: if owns(uid); allow write: if false; }
      match /withdrawals/{withdrawalId} { allow read: if owns(uid); allow write: if false; }
      match /subscriptions/{subscriptionId} { allow read: if owns(uid); allow write: if false; }
      match /entitlements/{entitlementId} { allow read: if owns(uid); allow write: if false; }
      match /rewardClaims/{claimId} { allow read: if owns(uid); allow write: if false; }
      match /activityCompletions/{completionId} { allow read: if owns(uid); allow write: if false; }
      match /streak/{summaryId} { allow read: if owns(uid); allow write: if false; }
      match /activityUsage/{usageId} { allow read, write: if false; }
      match /streakEvents/{eventId} { allow read, write: if false; }
      match /certifications/{courseId} { allow read: if owns(uid); allow write: if false; }
      match /trustedCourseProgress/{courseId} { allow read: if owns(uid); allow write: if false; }
      match /certificates/{certificateId} { allow read: if owns(uid); allow write: if false; }
    }

    match /courses/{courseId} { allow read: if resource.data.published == true; allow write: if false; }
    match /practiceQuestions/{questionId} { allow read: if resource.data.published == true; allow write: if false; }
    match /contentPublications/{publicationId} { allow read: if resource.data.status == 'ACTIVE'; allow write: if false; }
    match /dailyChallenges/{challengeId} { allow read: if resource.data.published == true; allow write: if false; }
    match /certificationExams/{examId} { allow read: if signedIn() && resource.data.published == true; allow write: if false; }

    match /examAttempts/{attemptId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create, update, delete: if false;
      match /responses/{responseId} { allow read: if attemptOwner(attemptId); allow write: if false; }
      match /integrityEvents/{eventId} { allow read: if runningAttemptOwner(attemptId); allow write: if false; }
      match /auditEvents/{eventId} { allow read: if attemptOwner(attemptId); allow write: if false; }
    }

    match /integrityReports/{reportId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /certificationReviews/{reviewId} {
      allow read: if signedIn() && resource.data.candidateUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /certificates/{credentialId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Global replay protection is an internal accounting primitive. Its keys and
    // records are never exposed to browser clients, including their owners.
    match /coinIdempotency/{idempotencyId} { allow read, write: if false; }
    match /referralCodes/{code} { allow read, write: if false; }
    match /referrals/{referralId} { allow read, write: if false; }
    match /referralPurchaseQualifications/{purchaseId} { allow read, write: if false; }
    match /walletSettlementIdempotency/{settlementId} { allow read, write: if false; }
    match /withdrawalIdempotency/{requestId} { allow read, write: if false; }
    match /withdrawalTransitionIdempotency/{transitionId} { allow read, write: if false; }
    match /withdrawalLookup/{withdrawalId} { allow read, write: if false; }
    match /paymentOrders/{orderId} { allow read, write: if false; }
    match /paymentOrderLookup/{orderId} { allow read, write: if false; }
    match /payments/{paymentId} { allow read, write: if false; }
    match /paymentEvents/{eventId} { allow read, write: if false; }
    match /paymentWebhookEvents/{eventId} { allow read, write: if false; }
    match /paymentActivations/{paymentId} { allow read, write: if false; }
    match /purchaseOrchestrations/{paymentId} { allow read, write: if false; }
    match /paymentSettlementEvidence/{evidenceId} { allow read, write: if false; }
    match /paymentReconciliation/{recordId} { allow read, write: if false; }
    match /payoutWebhookEvents/{eventId} { allow read, write: if false; }
    match /payoutOutbox/{withdrawalId} { allow read, write: if false; }
    match /financialReconciliation/{recordId} { allow read, write: if false; }
  }
}
