rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function attemptOwner(attemptId) {
      return signedIn() && get(/databases/$(database)/documents/examAttempts/$(attemptId)).data.ownerUid == request.auth.uid;
    }
    function runningAttemptOwner(attemptId) {
      let attempt = get(/databases/$(database)/documents/examAttempts/$(attemptId)).data;
      return signedIn() && attempt.ownerUid == request.auth.uid && attempt.state == 'RUNNING';
    }
    function validUserCreate(uid) {
      return request.resource.data.keys().hasOnly([
          'uid', 'email', 'name', 'avatar', 'emailVerified', 'providers',
          'createdAt', 'lastLogin', 'learningPreferences'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.avatar is string
        && request.resource.data.emailVerified is bool
        && request.resource.data.providers is list
        && request.resource.data.createdAt is string
        && request.resource.data.lastLogin is string
        && (!('email' in request.auth.token) || request.resource.data.email == request.auth.token.email)
        && (!('email_verified' in request.auth.token) || request.resource.data.emailVerified == request.auth.token.email_verified);
    }
    function validUserUpdate() {
      return request.resource.data.keys().hasOnly([
          'uid', 'email', 'name', 'avatar', 'emailVerified', 'providers',
          'createdAt', 'lastLogin', 'learningPreferences'
        ])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'avatar', 'learningPreferences', 'lastLogin'])
        && request.resource.data.name is string
        && request.resource.data.avatar is string
        && request.resource.data.lastLogin is string;
    }
    function validProgressRevision(courseId) {
      return request.resource.data.courseId == courseId
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1;
    }
    function validOwnedBrandTheme(uid) {
      return !('appearance' in request.resource.data)
        || !('brandTheme' in request.resource.data.appearance)
        || request.resource.data.appearance.brandTheme == 'blue'
        || exists(/databases/$(database)/documents/users/$(uid)/themeOwnership/$(request.resource.data.appearance.brandTheme));
    }
    function validActiveProject(projectId) {
      return request.resource.data.keys().hasAll([
          'schemaVersion', 'projectId', 'languageId', 'status', 'currentCheckpoint',
          'entryFilePath', 'revision', 'displayName', 'createdAt', 'startedAt',
          'completedAt', 'updatedAt', 'contentVersion', 'activeCheckpointId', 'activeTaskId'
        ])
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'projectId', 'languageId', 'status', 'currentCheckpoint',
          'entryFilePath', 'revision', 'displayName', 'createdAt', 'startedAt',
          'completedAt', 'updatedAt', 'contentVersion', 'activeCheckpointId', 'activeTaskId'
        ])
        && request.resource.data.schemaVersion == 3
        && (request.resource.data.contentVersion == null || (request.resource.data.contentVersion is int && request.resource.data.contentVersion > 0 && request.resource.data.contentVersion <= 1000000))
        && (request.resource.data.activeCheckpointId == null || (request.resource.data.activeCheckpointId is string && request.resource.data.activeCheckpointId.size() <= 120 && request.resource.data.activeCheckpointId.matches('^[a-z0-9]+([._-][a-z0-9]+)*$')))
        && (request.resource.data.activeTaskId == null || (request.resource.data.activeTaskId is string && request.resource.data.activeTaskId.size() <= 120 && request.resource.data.activeTaskId.matches('^[a-z0-9]+([._-][a-z0-9]+)*$')))
        && (request.resource.data.entryFilePath == null || (request.resource.data.entryFilePath is string && request.resource.data.entryFilePath.size() <= 120))
        && validProjectTimestamp(request.resource.data.createdAt)
        && (request.resource.data.startedAt == null || validProjectTimestamp(request.resource.data.startedAt))
        && (request.resource.data.completedAt == null || validProjectTimestamp(request.resource.data.completedAt))
        && validProjectTimestamp(request.resource.data.updatedAt)
        && request.resource.data.projectId == projectId
        && projectId.size() <= 120 && projectId.matches('^[a-z0-9]+([._-][a-z0-9]+)*$')
        && request.resource.data.languageId is string
        && request.resource.data.languageId.size() > 0
        && request.resource.data.languageId.size() <= 64
        && (!('displayName' in request.resource.data) || request.resource.data.displayName == null || (request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 80))
        && request.resource.data.status in ['active', 'completed']
        && request.resource.data.currentCheckpoint is int
        && request.resource.data.currentCheckpoint >= 0
        && request.resource.data.currentCheckpoint <= 100
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1 && request.resource.data.revision <= 1000000;
    }
    function validProjectTimestamp(value) {
      return value is string && value.size() == 24
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$');
    }
    function validProjectEvidence(value) {
      return value is map
        && value.keys().hasAll(['validatedAt', 'validatorSetVersion', 'passed', 'resultCount', 'passedCount'])
        && value.keys().hasOnly(['validatedAt', 'validatorSetVersion', 'passed', 'resultCount', 'passedCount'])
        && validProjectTimestamp(value.validatedAt)
        && value.validatorSetVersion == 1
        && value.passed is bool
        && value.resultCount is int && value.resultCount >= 0 && value.resultCount <= 50
        && value.passedCount is int && value.passedCount >= 0 && value.passedCount <= value.resultCount;
    }
    function validProjectChildParent(uid, projectId) {
      let parent = getAfter(/databases/$(database)/documents/users/$(uid)/activeProjects/$(projectId));
      return parent != null && parent.data.projectId == projectId && parent.data.schemaVersion == 3;
    }
    function validProjectTask(projectId, taskId) {
      let data = request.resource.data;
      return data.keys().hasAll(['projectId', 'taskId', 'status', 'startedAt', 'verifiedAt', 'completedAt', 'validationEvidence'])
        && data.keys().hasOnly(['projectId', 'taskId', 'status', 'startedAt', 'verifiedAt', 'completedAt', 'validationEvidence'])
        && data.projectId == projectId && data.taskId == taskId
        && taskId.matches('^[a-z0-9]+([._-][a-z0-9]+)*$') && taskId.size() <= 120
        && data.status in ['IN_PROGRESS', 'COMPLETED']
        && validProjectTimestamp(data.startedAt)
        && ((data.status == 'IN_PROGRESS' && data.verifiedAt == null && data.completedAt == null && data.validationEvidence == null)
          || (data.status == 'COMPLETED' && validProjectTimestamp(data.verifiedAt)
            && validProjectTimestamp(data.completedAt) && validProjectEvidence(data.validationEvidence)
            && data.validationEvidence.passed == true));
    }
    function validProjectCheckpoint(projectId, checkpointId) {
      let data = request.resource.data;
      return data.keys().hasAll(['projectId', 'checkpointId', 'status', 'completedAt', 'validationEvidence'])
        && data.keys().hasOnly(['projectId', 'checkpointId', 'status', 'completedAt', 'validationEvidence'])
        && data.projectId == projectId && data.checkpointId == checkpointId
        && checkpointId.matches('^[a-z0-9]+([._-][a-z0-9]+)*$') && checkpointId.size() <= 120
        && data.status in ['READY', 'COMPLETED']
        && ((data.status == 'READY' && data.completedAt == null && validProjectEvidence(data.validationEvidence)
          && data.validationEvidence.passed == false)
          || (data.status == 'COMPLETED' && validProjectTimestamp(data.completedAt)
            && (data.validationEvidence == null || (validProjectEvidence(data.validationEvidence) && data.validationEvidence.passed == true))));
    }
    function validProjectFinal(projectId, finalId) {
      let data = request.resource.data;
      return finalId == 'validation'
        && data.keys().hasAll(['projectId', 'status', 'completedAt', 'validationEvidence'])
        && data.keys().hasOnly(['projectId', 'status', 'completedAt', 'validationEvidence'])
        && data.projectId == projectId && data.status in ['FAILED', 'PASSED']
        && validProjectEvidence(data.validationEvidence)
        && ((data.status == 'FAILED' && data.completedAt == null && data.validationEvidence.passed == false)
          || (data.status == 'PASSED' && validProjectTimestamp(data.completedAt) && data.validationEvidence.passed == true));
    }
    function validActiveProjectFile() {
      return request.resource.data.keys().hasOnly(['path', 'type', 'encoding', 'content', 'editable', 'language'])
        && request.resource.data.path is string
        && request.resource.data.path.size() > 0
        && request.resource.data.path.size() <= 120
        && !request.resource.data.path.matches('(^|.*/)\\.\\.?($|/.*)')
        && !request.resource.data.path.matches('^/.*')
        && request.resource.data.type == 'file'
        && request.resource.data.encoding == 'utf-8'
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 262144
        && request.resource.data.editable is bool
        && (!('language' in request.resource.data) || (request.resource.data.language is string && request.resource.data.language.size() <= 64));
    }
    function validProjectFolder(projectId, folderId) {
      let data = request.resource.data;
      return data.keys().hasAll(['projectId', 'path']) && data.keys().hasOnly(['projectId', 'path'])
        && data.projectId == projectId && data.path is string
        && data.path.size() > 0 && data.path.size() <= 120
        && !data.path.matches('(^|.*/)\\.\\.?($|/.*)')
        && !data.path.matches('^/.*');
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid) && validUserCreate(uid);
      allow update: if owns(uid) && validUserUpdate();
      allow delete: if false;

      match /progress/{courseId} {
        allow read: if owns(uid);
        allow create: if owns(uid) && validProgressRevision(courseId) && request.resource.data.revision == 1;
        allow update: if owns(uid) && validProgressRevision(courseId)
          && (
            (!('revision' in resource.data) && request.resource.data.revision == 1)
            || (resource.data.revision is int && request.resource.data.revision == resource.data.revision + 1)
          );
        allow delete: if owns(uid);
      }
      match /activeProjects/{projectId} {
        allow read: if owns(uid);
        allow create: if owns(uid) && validActiveProject(projectId) && request.resource.data.revision == 1;
        allow update: if owns(uid) && validActiveProject(projectId)
          && resource.data.revision is int
          && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if owns(uid);
        match /files/{fileId} {
          allow read: if owns(uid);
          allow create, update: if owns(uid)
            && validActiveProjectFile()
             && (validProjectChildParent(uid, projectId)
               || getAfter(/databases/$(database)/documents/users/$(uid)/activeProjects/$(projectId)).data.fileIds.hasAny([fileId]));
          allow delete: if owns(uid);
        }
          match /folders/{folderId} {
            allow read: if owns(uid);
            allow create, update: if owns(uid) && validProjectChildParent(uid, projectId) && validProjectFolder(projectId, folderId);
            allow delete: if owns(uid);
          }
          match /tasks/{taskId} {
            allow read: if owns(uid);
            allow create, update: if owns(uid) && validProjectChildParent(uid, projectId) && validProjectTask(projectId, taskId);
            allow delete: if owns(uid);
          }
          match /checkpoints/{checkpointId} {
            allow read: if owns(uid);
            allow create, update: if owns(uid) && validProjectChildParent(uid, projectId) && validProjectCheckpoint(projectId, checkpointId);
            allow delete: if owns(uid);
          }
          match /final/{finalId} {
            allow read: if owns(uid);
            allow create, update: if owns(uid) && validProjectChildParent(uid, projectId) && validProjectFinal(projectId, finalId);
            allow delete: if owns(uid);
          }
      }
      match /bookmarks/{bookmarkId} { allow read, write: if owns(uid); }
      match /settings/{settingId} {
        allow read: if owns(uid);
        allow create, update: if owns(uid) && validOwnedBrandTheme(uid);
        allow delete: if owns(uid);
      }
      match /referrals/{referralId} { allow read: if owns(uid); allow write: if false; }
      match /referralIdentity/{identityId} { allow read: if owns(uid); allow write: if false; }
      match /referralAttribution/{attributionId} { allow read: if owns(uid); allow write: if false; }
      match /referralReadModel/{referralId} { allow read: if owns(uid); allow write: if false; }
      match /achievements/{achievementId} { allow read: if owns(uid); allow write: if false; }
      match /statistics/{statisticsId} { allow read: if owns(uid); allow write: if false; }
      match /coinTransactions/{transactionId} { allow read: if owns(uid); allow write: if false; }
      match /coinAccount/{accountId} { allow read: if owns(uid); allow write: if false; }
      match /coinRedemptions/{redemptionId} { allow read: if owns(uid); allow write: if false; }
      match /themeOwnership/{themeId} { allow read: if owns(uid); allow write: if false; }
      match /challengeUnlocks/{occurrenceDate} { allow read: if owns(uid); allow write: if false; }
      match /redemptionUsage/{usageId} { allow read, write: if false; }
      match /wallet/{accountId} { allow read: if owns(uid); allow write: if false; }
      match /walletTransactions/{transactionId} { allow read: if owns(uid); allow write: if false; }
      match /withdrawals/{withdrawalId} { allow read: if owns(uid); allow write: if false; }
      match /subscriptions/{subscriptionId} { allow read: if owns(uid); allow write: if false; }
      match /entitlements/{entitlementId} { allow read: if owns(uid); allow write: if false; }
      match /rewardClaims/{claimId} { allow read: if owns(uid); allow write: if false; }
      match /activityCompletions/{completionId} { allow read: if owns(uid); allow write: if false; }
      match /streak/{summaryId} { allow read: if owns(uid); allow write: if false; }
      match /activityUsage/{usageId} { allow read, write: if false; }
      match /streakEvents/{eventId} { allow read, write: if false; }
      match /certifications/{courseId} { allow read: if owns(uid); allow write: if false; }
      match /trustedCourseProgress/{courseId} { allow read: if owns(uid); allow write: if false; }
      match /certificates/{certificateId} { allow read: if owns(uid); allow write: if false; }
    }

    match /courses/{courseId} { allow read: if resource.data.published == true; allow write: if false; }
    match /practiceQuestions/{questionId} { allow read: if resource.data.published == true; allow write: if false; }
    match /contentPublications/{publicationId} { allow read: if resource.data.status == 'ACTIVE'; allow write: if false; }
    match /dailyChallenges/{challengeId} { allow read: if resource.data.published == true; allow write: if false; }
    match /certificationExams/{examId} { allow read: if signedIn() && resource.data.published == true; allow write: if false; }

    match /examAttempts/{attemptId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create, update, delete: if false;
      match /responses/{responseId} { allow read: if attemptOwner(attemptId); allow write: if false; }
      match /integrityEvents/{eventId} { allow read: if runningAttemptOwner(attemptId); allow write: if false; }
      match /auditEvents/{eventId} { allow read: if attemptOwner(attemptId); allow write: if false; }
    }

    match /integrityReports/{reportId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /certificationReviews/{reviewId} {
      allow read: if signedIn() && resource.data.candidateUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /certificates/{credentialId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Global replay protection is an internal accounting primitive. Its keys and
    // records are never exposed to browser clients, including their owners.
    match /coinIdempotency/{idempotencyId} { allow read, write: if false; }
    match /referralCodes/{code} { allow read, write: if false; }
    match /referrals/{referralId} { allow read, write: if false; }
    match /referralPurchaseQualifications/{purchaseId} { allow read, write: if false; }
    match /walletSettlementIdempotency/{settlementId} { allow read, write: if false; }
    match /withdrawalIdempotency/{requestId} { allow read, write: if false; }
    match /withdrawalTransitionIdempotency/{transitionId} { allow read, write: if false; }
    match /withdrawalLookup/{withdrawalId} { allow read, write: if false; }
    match /paymentOrders/{orderId} { allow read, write: if false; }
    match /paymentOrderLookup/{orderId} { allow read, write: if false; }
    match /payments/{paymentId} { allow read, write: if false; }
    match /paymentEvents/{eventId} { allow read, write: if false; }
    match /paymentWebhookEvents/{eventId} { allow read, write: if false; }
    match /paymentActivations/{paymentId} { allow read, write: if false; }
    match /purchaseOrchestrations/{paymentId} { allow read, write: if false; }
    match /paymentSettlementEvidence/{evidenceId} { allow read, write: if false; }
    match /paymentReconciliation/{recordId} { allow read, write: if false; }
    match /compilerShares/{shareId} { allow read, write: if false; }
    match /compilerFeedback/{feedbackId} { allow read, write: if false; }
    match /compilerPublicRateLimits/{rateLimitId} { allow read, write: if false; }
    match /compilerPublicRemoteRateLimits/{rateLimitId} { allow read, write: if false; }
    match /compilerPublicRemoteRuntime/{runtimeId} { allow read, write: if false; }
    match /compilerPublicMysqlRateLimits/{rateLimitId} { allow read, write: if false; }
    match /compilerPublicMysqlRuntime/{runtimeId} { allow read, write: if false; }
    match /payoutWebhookEvents/{eventId} { allow read, write: if false; }
    match /payoutOutbox/{withdrawalId} { allow read, write: if false; }
    match /financialReconciliation/{recordId} { allow read, write: if false; }
  }
}
