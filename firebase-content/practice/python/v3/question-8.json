  "schemaVersion": "1.0.0",
  "id": "BLIND150-008",
  "title": "Valid Sudoku",
  "summary": "Inspect the digits already placed on a Sudoku board.",
  "language": "Python",
  "difficulty": "medium",
  "topic": "Arrays & Hashing",
  "category": "dsa",
  "subtopic": "arrays-and-hashing",
  "questionType": "implementation",
  "estimatedMinutes": 35,
  "xp": 50,
  "contract": {
    "functionName": "isValidSudoku",
    "signature": "def isValidSudoku(board:",
    "input": "`board` (nested string arrays)",
    "output": "boolean."
  },
  "contractDetails": {
    "input": "`board` (nested string arrays)",
    "result": "boolean.",
    "constraints": "The board is 9×9. Each cell is one string from '.' and '1' through '9'. A dot marks an empty cell. Rows and columns are zero-based in the judge representation.",
    "output-checking": "Exact typed equality."
  },
  "statement": "Inspect the digits already placed on a Sudoku board. Return false if a digit repeats in any row, any column or any of the nine 3×3 boxes. Otherwise return true. A valid partial board does not have to be solvable.",
  "examples": [
    {
      "input": "{\"board\":[[\"6\",\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\"],[\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\"],[\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\"],[\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\"],[\".\",\".\",\".\",\".\",\"6\",\".\",\".\",\".\",\".\"],[\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\"],[\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\"],[\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\"],[\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\",\"2\"]]}",
      "output": "true",
      "explanation": "The two sixes share no row, column or box."
    },
    {
      "input": "{\"board\":[[\".\",\"4\",\".\",\".\",\".\",\".\",\".\",\".\",\".\"],[\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\"],[\".\",\".\",\"4\",\".\",\".\",\".\",\".\",\".\",\".\"],[\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\"],[\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\"],[\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\"],[\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\"],[\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\"],[\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\"]]}",
      "output": "false",
      "explanation": "The two fours are in the same upper-left box."
    },
    {
      "input": "{\"board\":[[\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\"],[\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\"],[\"9\",\".\",\".\",\".\",\".\",\".\",\".\",\".\",\"9\"],[\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\"],[\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\"],[\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\"],[\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\"],[\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\"],[\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\",\".\"]]}",
      "output": "false",
      "explanation": "Both nines are on row 2."
    }
  ],
  "constraints": [
    "The board is 9×9. Each cell is one string from '.' and '1' through '9'. A dot marks an empty cell. Rows and columns are zero-based in the judge representation."
  ],
  "hints": [
    "Conceptual: A digit occupies three regions at once.",
    "Directional: Track digits separately for rows, columns and boxes.",
    "Implementation: For row r and column c, use box number 3 × floor(r/3) + floor(c/3). Skip dots and reject a digit already present in any of its three regions."
  ],
  "concepts": [
    "matrices",
    "hash-sets",
    "sudoku"
  ],
  "skills": [
    "Matrices",
    "hash sets",
    "Sudoku"
  ],
