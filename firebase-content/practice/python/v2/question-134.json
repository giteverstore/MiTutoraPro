    "output": "A new mapping after the change."
  },
  "examples": [
    {
      "input": "key = theme, value = dark",
      "output": "[object Object]",
      "explanation": "Theme changes while language remains."
    }
  ],
  "constraints": [
    "1 <= number of entries <= 1000",
    "key exists"
  ],
  "concepts": [
    "mapping-state",
    "update"
  ],
