{
  "schemaVersion": "1.0.0",
  "id": "fund-arrays-010",
  "title": "Repair First-item Removal",
  "summary": "Fix removal so only the first matching item is removed.",
  "language": "Python",
  "difficulty": "easy",
  "topic": "arrays-lists",
  "category": "fundamentals",
  "subtopic": "adding-removing-updating-elements",
  "questionType": "debugging",
  "estimatedMinutes": 9,
  "xp": 45,
  "contract": {
    "functionName": "without_first_item",
    "signature": "without_first_item(items, target)",
    "input": "A collection and a target item.",
    "output": "A new collection without the first target occurrence."
  },
  "examples": [
    {
      "input": "items = [pen, book, pen], target = pen",
      "output": "book,pen",
      "explanation": "Only the first pen is removed."
    }
  ],
  "constraints": [
    "0 <= number of items <= 1000"
  ],
  "concepts": [
    "removing-elements",
    "duplicate-values"
  ],
  "skills": [
    "debugging-mutation",
    "state-tracking"
  ],
  "prerequisites": [
    "traversal",
    "conditions"
  ],
  "commonMistakes": [
    "removing every duplicate",
    "changing the supplied collection"
  ],
  "expectedComplexity": {
    "time": "O(n)",
    "space": "O(n)"
  },
  "publicTests": [
    {
      "name": "duplicate target",
      "arguments": [
        [
          "pen",
          "book",
          "pen"
        ],
        "pen"
      ],
      "expected": [
        "book",
        "pen"
      ]
    },
    {
      "name": "target absent",
      "arguments": [
        [
          1,
          2
        ],
        9
      ],
      "expected": [
        1,
        2
      ]
    }
  ],
  "implementations": {
    "python": {
