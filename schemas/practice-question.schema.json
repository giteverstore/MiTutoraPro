{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.learning-platform.local/practice-question.schema.json",
  "title": "MiTutora Practice Question",
  "description": "A standalone practice problem rendered with Learning Engine lesson blocks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "summary",
    "language",
    "difficulty",
    "topic",
    "category",
    "subtopic",
    "questionType",
    "estimatedMinutes",
    "xp",
    "skills",
    "blocks"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "learning-course.schema.json#/$defs/id" },
    "title": { "$ref": "learning-course.schema.json#/$defs/nonEmptyString" },
    "summary": { "$ref": "learning-course.schema.json#/$defs/nonEmptyString" },
    "language": { "$ref": "learning-course.schema.json#/$defs/nonEmptyString" },
    "difficulty": {
      "type": "string",
      "enum": ["very_easy", "easy", "medium", "hard"]
    },
    "topic": { "$ref": "learning-course.schema.json#/$defs/nonEmptyString" },
    "estimatedMinutes": { "type": "integer", "minimum": 1 },
    "xp": { "type": "integer", "minimum": 1 },
    "category": { "type": "string", "enum": ["fundamentals", "dsa", "general"] },
    "subtopic": { "$ref": "learning-course.schema.json#/$defs/nonEmptyString" },
    "questionType": { "type": "string", "enum": ["implementation", "debugging", "reasoning"] },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["functionName", "signature", "input", "output"],
      "properties": {
        "functionName": { "$ref": "learning-course.schema.json#/$defs/nonEmptyString" },
        "signature": { "$ref": "learning-course.schema.json#/$defs/nonEmptyString" },
        "input": { "$ref": "learning-course.schema.json#/$defs/nonEmptyString" },
        "output": { "$ref": "learning-course.schema.json#/$defs/nonEmptyString" }
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input", "output"],
        "properties": {
          "input": { "type": "string" },
          "output": { "type": "string" },
          "explanation": { "type": "string" }
        }
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "learning-course.schema.json#/$defs/nonEmptyString" }
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "learning-course.schema.json#/$defs/nonEmptyString" }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "learning-course.schema.json#/$defs/nonEmptyString" }
    },
    "prerequisites": {
      "type": "array",
      "items": { "$ref": "learning-course.schema.json#/$defs/nonEmptyString" }
    },
    "commonMistakes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "learning-course.schema.json#/$defs/nonEmptyString" }
    },
    "expectedComplexity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "space"],
      "properties": {
        "time": { "$ref": "learning-course.schema.json#/$defs/nonEmptyString" },
        "space": { "$ref": "learning-course.schema.json#/$defs/nonEmptyString" }
      }
    },
    "publicTests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "arguments", "expected"],
        "properties": {
          "name": { "$ref": "learning-course.schema.json#/$defs/nonEmptyString" },
          "arguments": { "type": "array" },
          "expected": {}
        }
      }
    },
    "implementations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python"],
      "properties": {
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": ["languageId", "signature", "entryPoint"],
          "properties": {
            "languageId": { "const": "python" },
            "signature": { "$ref": "learning-course.schema.json#/$defs/nonEmptyString" },
            "entryPoint": { "$ref": "learning-course.schema.json#/$defs/nonEmptyString" }
          }
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "learning-course.schema.json#/$defs/block" },
      "contains": {
        "type": "object",
        "properties": { "type": { "const": "compiler" } },
        "required": ["type"]
      },
      "minContains": 1,
      "maxContains": 1
    }
  },
  "$defs": {
    "firestoreMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "summary", "language", "topic", "category", "subtopic",
        "questionType", "skills", "difficulty", "estimatedMinutes", "xp", "position",
        "published", "version", "storagePath", "contentHash"
      ],
      "properties": {
        "id": { "$ref": "#/properties/id" },
        "title": { "$ref": "#/properties/title" },
        "summary": { "$ref": "#/properties/summary" },
        "language": { "$ref": "#/properties/language" },
        "topic": { "$ref": "#/properties/topic" },
        "category": { "$ref": "#/properties/category" },
        "subtopic": { "$ref": "#/properties/subtopic" },
        "questionType": { "$ref": "#/properties/questionType" },
        "skills": { "$ref": "#/properties/skills" },
        "difficulty": { "$ref": "#/properties/difficulty" },
        "estimatedMinutes": { "$ref": "#/properties/estimatedMinutes" },
        "xp": { "$ref": "#/properties/xp" },
        "position": { "type": "integer", "minimum": 1 },
        "published": { "const": true },
        "version": { "type": "string", "pattern": "^v[1-9][0-9]*$" },
        "storagePath": { "type": "string", "pattern": "^practice/python/question-[1-9][0-9]*\\.json$" },
        "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
