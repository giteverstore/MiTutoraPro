{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.learning-platform.local/practice-question.schema.json",
  "title": "MiTutora Practice Question",
  "description": "A standalone practice problem rendered with Learning Engine lesson blocks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "summary",
    "language",
    "difficulty",
    "topic",
    "estimatedMinutes",
    "xp",
    "blocks"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "learning-course.schema.json#/$defs/id" },
    "title": { "$ref": "learning-course.schema.json#/$defs/nonEmptyString" },
    "summary": { "$ref": "learning-course.schema.json#/$defs/nonEmptyString" },
    "language": { "$ref": "learning-course.schema.json#/$defs/nonEmptyString" },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "medium", "hard"]
    },
    "topic": { "$ref": "learning-course.schema.json#/$defs/nonEmptyString" },
    "estimatedMinutes": { "type": "integer", "minimum": 1 },
    "xp": { "type": "integer", "minimum": 1 },
    "blocks": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "learning-course.schema.json#/$defs/block" },
      "contains": {
        "type": "object",
        "properties": { "type": { "const": "compiler" } },
        "required": ["type"]
      },
      "minContains": 1,
      "maxContains": 1
    }
  }
}
