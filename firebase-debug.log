[debug] [2026-09-14T17:23:25.244Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/mi-tutora-pro/rulesets {"name":"projects/mi-tutora-pro/rulesets/acf0f166-695e-45e9-ad31-4da60bb0485c","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() { return request.auth != null; }\n    function owns(uid) { return signedIn() && request.auth.uid == uid; }\n    function attemptOwner(attemptId) {\n      return signedIn() && get(/databases/$(database)/documents/examAttempts/$(attemptId)).data.ownerUid == request.auth.uid;\n    }\n    function runningAttemptOwner(attemptId) {\n      let attempt = get(/databases/$(database)/documents/examAttempts/$(attemptId)).data;\n      return signedIn() && attempt.ownerUid == request.auth.uid && attempt.state == 'RUNNING';\n    }\n    function validUserCreate(uid) {\n      return request.resource.data.keys().hasOnly([\n          'uid', 'email', 'name', 'avatar', 'emailVerified', 'providers',\n          'createdAt', 'lastLogin', 'learningPreferences'\n        ])\n        && request.resource.data.uid == uid\n        && request.resource.data.email is string\n        && request.resource.data.name is string\n        && request.resource.data.avatar is string\n        && request.resource.data.emailVerified is bool\n        && request.resource.data.providers is list\n        && request.resource.data.createdAt is string\n        && request.resource.data.lastLogin is string\n        && (!('email' in request.auth.token) || request.resource.data.email == request.auth.token.email)\n        && (!('email_verified' in request.auth.token) || request.resource.data.emailVerified == request.auth.token.email_verified);\n    }\n    function validUserUpdate() {\n      return request.resource.data.keys().hasOnly([\n          'uid', 'email', 'name', 'avatar', 'emailVerified', 'providers',\n          'createdAt', 'lastLogin', 'learningPreferences'\n        ])\n        && request.resource.data.diff(resource.data).affectedKeys()\n          .hasOnly(['name', 'avatar', 'learningPreferences', 'lastLogin'])\n        && request.resource.data.name is string\n        && request.resource.data.avatar is string\n        && request.resource.data.lastLogin is string;\n    }\n    function validProgressRevision(courseId) {\n      return request.resource.data.courseId == courseId\n        && request.resource.data.revision is int\n        && request.resource.data.revision >= 1;\n    }\n\n    match /users/{uid} {\n      allow read: if owns(uid);\n      allow create: if owns(uid) && validUserCreate(uid);\n      allow update: if owns(uid) && validUserUpdate();\n      allow delete: if false;\n\n      match /progress/{courseId} {\n        allow read: if owns(uid);\n        allow create: if owns(uid) && validProgressRevision(courseId) && request.resource.data.revision == 1;\n        allow update: if owns(uid) && validProgressRevision(courseId)\n          && (\n            (!('revision' in resource.data) && request.resource.data.revision == 1)\n            || (resource.data.revision is int && request.resource.data.revision == resource.data.revision + 1)\n          );\n        allow delete: if owns(uid);\n      }\n      match /bookmarks/{bookmarkId} { allow read, write: if owns(uid); }\n      match /settings/{settingId} { allow read, write: if owns(uid); }\n      match /referrals/{referralId} { allow read: if owns(uid); allow write: if false; }\n      match /referralIdentity/{identityId} { allow read: if owns(uid); allow write: if false; }\n      match /referralAttribution/{attributionId} { allow read: if owns(uid); allow write: if false; }\n      match /referralReadModel/{referralId} { allow read: if owns(uid); allow write: if false; }\n      match /achievements/{achievementId} { allow read: if owns(uid); allow write: if false; }\n      match /statistics/{statisticsId} { allow read: if owns(uid); allow write: if false; }\n      match /coinTransactions/{transactionId} { allow read: if owns(uid); allow write: if false; }\n      match /coinAccount/{accountId} { allow read: if owns(uid); allow write: if false; }\n      match /coinRedemptions/{redemptionId} { allow read: if owns(uid); allow write: if false; }\n      match /challengeUnlocks/{occurrenceDate} { allow read: if owns(uid); allow write: if false; }\n      match /redemptionUsage/{usageId} { allow read, write: if false; }\n      match /wallet/{accountId} { allow read: if owns(uid); allow write: if false; }\n      match /walletTransactions/{transactionId} { allow read: if owns(uid); allow write: if false; }\n      match /withdrawals/{withdrawalId} { allow read: if owns(uid); allow write: if false; }\n      match /subscriptions/{subscriptionId} { allow read: if owns(uid); allow write: if false; }\n      match /entitlements/{entitlementId} { allow read: if owns(uid); allow write: if false; }\n      match /rewardClaims/{claimId} { allow read: if owns(uid); allow write: if false; }\n      match /activityCompletions/{completionId} { allow read: if owns(uid); allow write: if false; }\n      match /streak/{summaryId} { allow read: if owns(uid); allow write: if false; }\n      match /activityUsage/{usageId} { allow read, write: if false; }\n      match /streakEvents/{eventId} { allow read, write: if false; }\n      match /certifications/{courseId} { allow read: if owns(uid); allow write: if false; }\n      match /trustedCourseProgress/{courseId} { allow read: if owns(uid); allow write: if false; }\n      match /certificates/{certificateId} { allow read: if owns(uid); allow write: if false; }\n    }\n\n    match /courses/{courseId} { allow read: if resource.data.published == true; allow write: if false; }\n    match /practiceQuestions/{questionId} { allow read: if resource.data.published == true; allow write: if false; }\n    match /contentPublications/{publicationId} { allow read: if resource.data.status == 'ACTIVE'; allow write: if false; }\n    match /dailyChallenges/{challengeId} { allow read: if resource.data.published == true; allow write: if false; }\n    match /certificationExams/{examId} { allow read: if signedIn() && resource.data.published == true; allow write: if false; }\n\n    match /examAttempts/{attemptId} {\n      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;\n      allow create, update, delete: if false;\n      match /responses/{responseId} { allow read: if attemptOwner(attemptId); allow write: if false; }\n      match /integrityEvents/{eventId} { allow read: if runningAttemptOwner(attemptId); allow write: if false; }\n      match /auditEvents/{eventId} { allow read: if attemptOwner(attemptId); allow write: if false; }\n    }\n\n    match /integrityReports/{reportId} {\n      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;\n      allow create, update, delete: if false;\n    }\n\n    match /certificationReviews/{reviewId} {\n      allow read: if signedIn() && resource.data.candidateUid == request.auth.uid;\n      allow create, update, delete: if false;\n    }\n\n    match /certificates/{credentialId} {\n      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;\n      allow create, update, delete: if false;\n    }\n\n    // Global replay protection is an internal accounting primitive. Its keys and\n    // records are never exposed to browser clients, including their owners.\n    match /coinIdempotency/{idempotencyId} { allow read, write: if false; }\n    match /referralCodes/{code} { allow read, write: if false; }\n    match /referrals/{referralId} { allow read, write: if false; }\n    match /referralPurchaseQualifications/{purchaseId} { allow read, write: if false; }\n    match /walletSettlementIdempotency/{settlementId} { allow read, write: if false; }\n    match /withdrawalIdempotency/{requestId} { allow read, write: if false; }\n    match /withdrawalTransitionIdempotency/{transitionId} { allow read, write: if false; }\n    match /withdrawalLookup/{withdrawalId} { allow read, write: if false; }\n    match /paymentOrders/{orderId} { allow read, write: if false; }\n    match /paymentOrderLookup/{orderId} { allow read, write: if false; }\n    match /payments/{paymentId} { allow read, write: if false; }\n    match /paymentEvents/{eventId} { allow read, write: if false; }\n    match /paymentWebhookEvents/{eventId} { allow read, write: if false; }\n    match /paymentActivations/{paymentId} { allow read, write: if false; }\n    match /purchaseOrchestrations/{paymentId} { allow read, write: if false; }\n    match /paymentSettlementEvidence/{evidenceId} { allow read, write: if false; }\n    match /paymentReconciliation/{recordId} { allow read, write: if false; }\n    match /payoutWebhookEvents/{eventId} { allow read, write: if false; }\n    match /payoutOutbox/{withdrawalId} { allow read, write: if false; }\n    match /financialReconciliation/{recordId} { allow read, write: if false; }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-09-14T17:23:25.436415Z","metadata":{"services":["cloud.firestore"]}}
