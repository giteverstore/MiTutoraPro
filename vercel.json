{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "functions": {
    "api/ai/explain.js": {
      "maxDuration": 60,
      "supportsCancellation": true
    }
  },
  "crons": [
    {
      "path": "/api/payments/reconcile",
      "schedule": "15 2 * * *"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/((?!api(?:/|$)|assets(?:/|$)|vendor(?:/|$)|src(?:/|$)|node_modules(?:/|$)|@[^/]+(?:/|$))[^.]*)",
      "dest": "/index.html"
    }
  ]
}
